# 复制为 deploy/.env 并填写（.env 不会提交到 Git）
# 网站域名（需先把域名 A 记录解析到服务器 IP）
DOMAIN=smallbiz.example.com

# 数据库密码：用 openssl rand -base64 24 生成
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# 登录令牌签名密钥，至少 32 个字符：用 openssl rand -base64 48 生成
JWT_SECRET=

# 平台管理员邮箱（逗号分隔），用这些邮箱注册/登录后可进入 /admin
PLATFORM_ADMIN_EMAILS=

# 人工客服微信号（只显示在本网站内）
SUPPORT_WECHAT_ID=Pianzibudehaosi_1A

# AI 客服（可选）：Anthropic API 密钥。不填则客服只用关键词匹配
ANTHROPIC_API_KEY=
# 模型（默认最便宜的 Haiku），以及每天全平台 / 每个 IP 的 AI 回答次数上限
AI_SUPPORT_MODEL=claude-haiku-5-5
AI_SUPPORT_DAILY_LIMIT=1000
AI_SUPPORT_PER_IP_DAILY_LIMIT=30
